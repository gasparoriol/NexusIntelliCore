; Python — Flask debug server / Django DEBUG setting.
(call
  function: (attribute attribute: (identifier) @_m (#eq? @_m "run"))
  arguments: (argument_list
    (keyword_argument name: (identifier) @_k (#eq? @_k "debug") value: (true)))) @debug_on
(module
  (expression_statement
    (assignment left: (identifier) @_l (#eq? @_l "DEBUG") right: (true)) @debug_on))
