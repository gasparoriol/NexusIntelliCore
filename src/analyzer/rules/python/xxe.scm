; Python — lxml parser with entity resolution or network access enabled.
(call
  function: [(identifier) @_f (attribute attribute: (identifier) @_f)] (#eq? @_f "XMLParser")
  arguments: (argument_list
    (keyword_argument name: (identifier) @_k (#eq? @_k "resolve_entities") value: (true)))) @xxe
(call
  function: [(identifier) @_f (attribute attribute: (identifier) @_f)] (#eq? @_f "XMLParser")
  arguments: (argument_list
    (keyword_argument name: (identifier) @_k (#eq? @_k "no_network") value: (false)))) @xxe
